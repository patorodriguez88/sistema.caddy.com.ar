# Buffer de salida más grande: con el default (4096) muchas páginas ya mandan los
# headers reales antes de llegar al menú (topnav.html), y ahí session_start() falla
# de verdad (no es solo un warning) — el usuario logueado deja de verse en esa request
# y el menú de permisos cae siempre en "sin sesión = mostrar todo". Con esto, PHP no
# manda nada hasta terminar la página (o superar este tamaño), así session_start()
# funciona en cualquier punto de la ejecución, como espera el resto del sistema.
php_value output_buffering 65536

# Activar mod_rewrite
RewriteEngine On

# En LOCAL la app cuelga de /SistemaTriangular
# porque entrás como: http://localhost:3000/SistemaTriangular/...
RewriteBase /SistemaTriangular/

########################################
# 1) Atajo especial:
#    /SistemaTriangular/Clientes  -> /SistemaTriangular/Clientes/Clientes.php
########################################
RewriteRule ^Clientes/?$ Clientes/Clientes.php [L,QSA]

########################################
# 2) No tocar si la URL ya tiene extensión
#    (css, js, imágenes, .php explícitos, etc.)
########################################
RewriteCond %{REQUEST_URI} \.[A-Za-z0-9]+$
RewriteRule ^ - [L]

########################################
# 3) URLs SIN extensión -> probar .php
#    /SistemaTriangular/login               -> /SistemaTriangular/login.php
#    /SistemaTriangular/Logistica/Ordenes   -> /SistemaTriangular/Logistica/Ordenes.php
#    /SistemaTriangular/Algo/OtraCosa/Ver   -> /SistemaTriangular/Algo/OtraCosa/Ver.php
########################################
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

########################################
# 4) Si no hay .php, probar .html
########################################
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L,QSA]

########################################
# 5) Si tampoco, probar .htm
########################################
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.htm -f
RewriteRule ^(.+?)/?$ $1.htm [L,QSA]