# Activar mod_rewrite
RewriteEngine On

# Tu docroot ES SistemaTriangular
# Ej: http://localhost/Clientes o https://tudominio.com/Clientes
RewriteBase /

# 1) Regla ESPECIAL: /Clientes -> /Clientes/Clientes.php
# (va ANTES de comprobar si existe el directorio, si no, no entra nunca)
RewriteRule ^Clientes/?$ Clientes/Clientes.php [L,QSA]

# 2) AHORA sí: si archivo o carpeta existen, no toco nada
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3) (Opcional) Genérico para archivos PHP en la raíz
#    /login -> /login.php
RewriteRule ^([^/]+)/?$ $1.php [L,QSA]

# 4) (Opcional) Redirección elegante de /archivo.php -> /archivo
#    Solo para archivos PHP de la raíz (no toca Clientes/)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[\s?]
RewriteRule ^ %1 [R=302,L]